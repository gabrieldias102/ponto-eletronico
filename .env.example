# Banco de dados (local: docker compose up -d)
DATABASE_URL="postgresql://pontual:pontual@localhost:5433/pontual"

# Better Auth: gere com `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail (Resend). Sem chave, os e-mails são exibidos no console.
RESEND_API_KEY=""
EMAIL_FROM="Pontual <nao-responda@exemplo.com.br>"

# Arquivos (Vercel Blob). Sem token, os arquivos vão para public/uploads (apenas desenvolvimento).
BLOB_READ_WRITE_TOKEN=""

# Administrador inicial criado pelo seed
SEED_ADMIN_EMAIL="admin@pontual.local"
SEED_ADMIN_PASSWORD="admin12345"
