generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum ScheduleType {
  /// Períodos por dia da semana
  WEEKLY
  /// Ciclo de N dias contado a partir de uma data (12x36, 24x48, 6x1...)
  CYCLE
}

enum AdjustmentType {
  /// Esqueceu de bater: inclui uma marcação
  INCLUSION
  /// Bateu no horário errado: desconsidera a marcação original e inclui o horário correto
  CORRECTION
  /// Abono de falta ou de período (ex.: atestado)
  ABSENCE
}

enum AdjustmentStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewStep {
  MANAGER
  HR
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum HolidayScope {
  NATIONAL
  STATE
  MUNICIPAL
}

/// Configuração única da organização (registro com id "default").
model Organization {
  id           String  @id @default("default")
  name         String
  legalName    String?
  taxId        String? /// CNPJ ou CPF do empregador
  logoUrl      String?
  primaryColor String  @default("#0d9488")

  // Validações exigidas na batida (padrão da empresa; cada usuário pode sobrescrever)
  punchRequireGeolocation Boolean @default(false)
  punchRequireGeofence    Boolean @default(false)
  punchRequireSelfie      Boolean @default(false)
  punchRequireQrCode      Boolean @default(false)

  /// Horário comercial usado no aviso de batida fora do horário até existirem jornadas (Fase 3).
  businessHoursStart String @default("08:00")
  businessHoursEnd   String @default("18:00")
  /// Dias úteis: 0 = domingo ... 6 = sábado
  businessDays       Int[]  @default([1, 2, 3, 4, 5])

  /// Segredo do QR code rotativo do painel. Trocar invalida o painel atual.
  qrSecret String?

  /// Tolerância de atraso/antecipação por marcação e por dia (CLT art. 58, §1º: 5 e 10 min).
  tolerancePerPunchMinutes     Int @default(5)
  toleranceDailyMinutes        Int @default(10)
  /// Margem antes/depois da jornada em que a batida não gera aviso de "fora do horário".
  scheduleWarningMarginMinutes Int @default(30)

  // Solicitações de ajuste
  adjustmentRequireJustification Boolean @default(false)
  adjustmentRequireAttachment    Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("organization")
}

/// Local permitido para a cerca virtual.
model AllowedLocation {
  id           String      @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  timeEntries  TimeEntry[]

  @@map("allowed_locations")
}

/// Marcação de ponto. Imutável: um trigger no banco bloqueia UPDATE e DELETE.
model TimeEntry {
  id                   String              @id @default(cuid())
  /// Número Sequencial de Registro (Portaria 671), sem lacunas.
  nsr                  BigInt              @unique
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Hora do servidor no momento da batida.
  punchedAt            DateTime            @db.Timestamptz(3)
  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?
  allowedLocationId    String?
  allowedLocation      AllowedLocation?    @relation(fields: [allowedLocationId], references: [id], onDelete: Restrict)
  corrections          AdjustmentRequest[]
  /// Chave do arquivo privado da selfie.
  selfieKey            String?
  qrVerified           Boolean             @default(false)
  outsideBusinessHours Boolean             @default(false)
  ip                   String?
  userAgent            String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)

  @@index([userId, punchedAt])
  @@index([punchedAt])
  @@map("time_entries")
}

/// Contador do NSR. Linha única travada na transação de cada batida.
model NsrCounter {
  id    Int    @id @default(1)
  value BigInt @default(0)

  @@map("nsr_counter")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  managerId String?
  manager   User?    @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   User[]   @relation("DepartmentMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          Role        @default(EMPLOYEE)
  active        Boolean     @default(true)
  departmentId  String?
  department    Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  // Sobrescrevem as validações da empresa. null = segue o padrão da empresa.
  punchRequireGeolocation Boolean?
  punchRequireGeofence    Boolean?
  punchRequireSelfie      Boolean?
  punchRequireQrCode      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedDepartments  Department[]         @relation("DepartmentManager")
  sessions            Session[]
  accounts            Account[]
  auditLogs           AuditLog[]
  timeEntries         TimeEntry[]
  scheduleAssignments ScheduleAssignment[]
  adjustmentRequests  AdjustmentRequest[]  @relation("AdjustmentRequester")
  adjustmentReviews   AdjustmentReview[]
  notifications       Notification[]

  @@index([departmentId])
  @@map("users")
}

/// Registro de auditoria. Somente inserção.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Tabelas usadas pelo Better Auth
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Jornada de trabalho reutilizável.
model WorkSchedule {
  id              String       @id @default(cuid())
  name            String       @unique
  description     String?
  type            ScheduleType
  /// WEEKLY: { "0": [períodos], ..., "6": [...] } (0 = domingo)
  /// CYCLE:  [[períodos do dia 1], [dia 2], ...]; lista vazia = folga
  /// Período: { "start": "HH:mm", "end": "HH:mm" }; término <= início atravessa a meia-noite.
  days            Json
  /// CYCLE: data (YYYY-MM-DD) que corresponde ao dia 1 do ciclo.
  cycleStartDate  String?
  /// Se trabalha em feriados (comum em 12x36). Senão, feriado é folga.
  worksOnHolidays Boolean      @default(false)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments ScheduleAssignment[]

  @@map("work_schedules")
}

/// Histórico de jornadas do funcionário. Vale a atribuição com a maior data de início <= dia.
model ScheduleAssignment {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  /// Data local (YYYY-MM-DD) a partir da qual a jornada vale.
  startDate  String
  createdAt  DateTime     @default(now())

  @@unique([userId, startDate])
  @@map("schedule_assignments")
}

/// Feriado da empresa: folga para jornadas que não trabalham em feriados.
model Holiday {
  id        String       @id @default(cuid())
  /// Data local (YYYY-MM-DD)
  date      String
  name      String
  scope     HolidayScope
  createdAt DateTime     @default(now())

  @@unique([date, name])
  @@index([date])
  @@map("holidays")
}

/// Solicitação de ajuste de ponto. Aprovada, vira tratamento sobre as marcações (que nunca mudam).
model AdjustmentRequest {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("AdjustmentRequester", fields: [userId], references: [id], onDelete: Restrict)
  type   AdjustmentType
  status AdjustmentStatus

  /// Dia do ajuste (YYYY-MM-DD). No abono, o primeiro dia.
  date    String
  /// Abono de vários dias: último dia (inclusive).
  endDate String?

  /// INCLUSION/CORRECTION: horário pedido (instante UTC calculado a partir de date + hora local).
  requestedAt DateTime?  @db.Timestamptz(3)
  /// CORRECTION: marcação que será desconsiderada.
  timeEntryId String?
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)

  /// ABSENCE parcial (um único dia): período abonado em hora local "HH:mm".
  absenceStart String?
  absenceEnd   String?

  justification  String?
  attachmentKey  String?
  attachmentName String?
  attachmentType String?

  /// Reenvio de uma solicitação rejeitada.
  previousRequestId String?
  previousRequest   AdjustmentRequest?  @relation("Resubmission", fields: [previousRequestId], references: [id], onDelete: SetNull)
  resubmissions     AdjustmentRequest[] @relation("Resubmission")

  reviews   AdjustmentReview[]
  decidedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, date])
  @@index([status])
  @@map("adjustment_requests")
}

model AdjustmentReview {
  id         String            @id @default(cuid())
  requestId  String
  request    AdjustmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step       ReviewStep
  reviewerId String
  reviewer   User              @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision   ReviewDecision
  comment    String?
  createdAt  DateTime          @default(now())

  @@index([requestId])
  @@map("adjustment_reviews")
}

/// Notificação dentro do sistema (também enviada por e-mail).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
